{
  "App": {
    "SelfUrl": "https://localhost:44312",
    "AngularUrl": "http://localhost:4200",
    "CorsOrigins": "https://*.SmartPantry.com,http://localhost:4200,",
    "RedirectAllowedUrls": "http://localhost:4200,",
    "DisablePII": false,
    "HealthCheckUrl": "/health-status"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=SmartPantry;Trusted_Connection=True;TrustServerCertificate=true"
  },
  "AuthServer": {
    "Authority": "https://localhost:44312",
    "RequireHttpsMetadata": true,
    "SwaggerClientId": "SmartPantry_Swagger",
    "CertificatePassPhrase": "32ee3e36-a669-4b36-9b23-7f9261d788e2"
  },
  "StringEncryption": {
    "DefaultPassPhrase": "uYsewVcR2YMJrbiQ"
  }}